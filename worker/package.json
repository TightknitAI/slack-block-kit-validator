{
  "name": "@tightknitai/slack-block-kit-validator-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Worker hosting a public, rate-limited Slack Block Kit validation API and MCP server.",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @tightknitai/slack-block-kit-validator build",
    "dev": "wrangler dev",
    "predeploy": "pnpm --filter @tightknitai/slack-block-kit-validator build",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tightknitai/slack-block-kit-validator": "workspace:*",
    "agents": "^0.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260519.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.93.0"
  }
}
